{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(cmd/**)",
      "Edit(internal/**)",
      "Edit(web/**)",
      "Edit(schemas/**)",
      "Edit(templates/**)",
      "Edit(testdata/**)",
      "Edit(docs/**)",
      "Edit(.claude/work/**)",
      "Edit(go.mod)",
      "Edit(go.sum)",
      "Edit(.golangci.yml)",
      "Edit(.github/**)",
      "Edit(README.md)",
      "Edit(CLAUDE.md)",
      "Read(.env.sample)",
      "Edit(.env.sample)",

      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go run ./cmd/musubi *)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(go mod download)",
      "Bash(go list *)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(gofmt *)",
      "Bash(golangci-lint run *)",
      "Bash(golangci-lint run)",
      "Bash(govulncheck *)",

      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-tree *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git merge origin/*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git push)",

      "Bash(gh auth status)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr view)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh api graphql *)",
      "Bash(bash .claude/skills/address-pr/scripts/fetch-threads.sh *)",
      "Bash(bash .claude/skills/address-pr/scripts/reply-resolve.sh *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * main)",
      "Bash(git push * develop)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh repo delete *)",
      "Bash(gh release *)",
      "Bash(rm -rf *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-branch.py\"",
            "timeout": 10,
            "statusMessage": "ブランチ保護を確認中"
          }
        ]
      }
    ]
  }
}
